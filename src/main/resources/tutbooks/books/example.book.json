{
  "schema": "tutbooks.book.v1",
  "id": "example:getting-started",
  "title": "Getting Started",
  "subtitle": "Build tutorial books for your mod",
  "author": "Example Team",
  "version": "1.0.0",
  "mod": "example",
  "lang": "en-US",
  "theme": {
    "pageWidth": 320,
    "pageHeight": 420,
    "font": "Serif",
    "color": "#1A1A1A",
    "accent": "#2B6CB0",
    "headerAlign": "center",
    "footerAlign": "right"
  },
  "toc": [
    { "label": "Intro", "target": { "page": "p1", "anchor": "intro" } },
    { "label": "Setup", "target": { "page": "p2", "anchor": "setup" } },
    { "label": "Controls", "target": { "page": "p3", "anchor": "controls" } }
  ],
  "pages": [
    {
      "id": "p1",
      "header": { "text": "Tutorial Book" },
      "footer": { "text": "Page {page}/{pages}" },
      "blocks": [
        { "type": "title", "id": "intro", "text": "Welcome" },
        {
          "type": "paragraph",
          "text": "This book shows how to structure tutorials with anchors, links, and buttons."
        },
        {
          "type": "image",
          "src": "tutbooks/assets/example/cover.png",
          "alt": "Cover art",
          "width": 200,
          "height": 120
        },
        {
          "type": "button",
          "text": "Go to Setup",
          "action": { "type": "goto", "page": "p2", "anchor": "setup" }
        },
        {
          "type": "link",
          "text": "Project site",
          "url": "https://example.com"
        }
      ]
    },
    {
      "id": "p2",
      "header": { "text": "Setup" },
      "footer": { "text": "Page {page}/{pages}" },
      "blocks": [
        { "type": "title", "id": "setup", "text": "Install and open" },
        {
          "type": "list",
          "ordered": true,
          "items": [
            "Install the mod or modpack",
            "Open the tutorial book menu",
            "Pick the book you want"
          ]
        },
        { "type": "divider" },
        {
          "type": "quote",
          "text": "Short steps beat long walls of text.",
          "cite": "Design tip"
        },
        {
          "type": "button",
          "text": "Jump to Controls",
          "action": { "type": "goto", "page": "p3", "anchor": "controls" }
        }
      ]
    },
    {
      "id": "p3",
      "header": { "text": "Controls" },
      "footer": { "text": "Page {page}/{pages}" },
      "blocks": [
        { "type": "title", "id": "controls", "text": "Navigation" },
        {
          "type": "paragraph",
          "text": "Buttons can jump to anchors on any page. Use ids on blocks to mark targets."
        },
        {
          "type": "button",
          "text": "Back to Intro",
          "action": { "type": "goto", "page": "p1", "anchor": "intro" }
        },
        {
          "type": "button",
          "text": "Previous Page",
          "action": { "type": "prev_page" }
        }
      ]
    }
  ]
}
